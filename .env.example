# WorldQuant Brain Credentials
BRAIN_USERNAME=your_worldquant_brain_username
BRAIN_PASSWORD=your_worldquant_brain_password

# LLM Provider Configuration
# Choose one of the following providers:

# ── 1. Google Gemini Flash (Recommended: gemini-2.5-flash or gemini-2.0-flash) ──
GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ── 2. Groq (Fast inference, e.g. openai/gpt-oss-120b or llama-3.3-70b-versatile) ──
# GROQ_API_KEY=gsk_your_groq_api_key_here
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1

# ── 3. DeepSeek / Other OpenAI-compatible APIs ──
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com

# Optional Network Proxy (if required)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

