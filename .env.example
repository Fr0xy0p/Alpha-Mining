# WorldQuant Brain Credentials
BRAIN_USERNAME=your_worldquant_brain_username
BRAIN_PASSWORD=your_worldquant_brain_password

# LLM Provider Configuration
# ── Groq (Fast inference, recommended: llama-3.3-70b-versatile) ──
GROQ_API_KEY=gsk_your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1

# ── Or DeepSeek / Other OpenAI-compatible APIs ──
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com

# Optional Network Proxy (if required)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

